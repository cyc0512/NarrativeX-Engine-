  "nodes": {
    "n1_entry": {
      "kind": "scripted",
      "priority": 100,
      "once": true,
      "window": {
        "min_step": 0,
        "max_step": 2
      },
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "presentation": {
        "narrator": "周末的傍晚，你推开家门。玄关的灯还没开，厨房里却亮着一团暖黄的光，飘出阵阵香味。木子因系着围裙，背对着你，一下一下地切菜。",
        "npc_text": "哥哥，你回来啦？今天大学那边累不累？晚饭马上就好，你先去洗手吧。",
        "npc_state": "平静，背对着你",
        "hint": "【提示】走过去打个招呼。"
      },
      "options": [
        {
          "text": "1. 走过去打招呼。",
          "next": "n2_kitchen"
        }
      ],
      "default_next": "n2_kitchen",
      "fallback_next": "n_idle",
      "effects": {
        "summary_hint": "哥哥回了家。"
      },
      "intent": {
        "description": "开场：哥哥刚回到家，木子因在厨房做饭，用于承接任何开场寒暄。",
        "keywords": [
          "回来了",
          "好香",
          "我饿"
        ],
        "examples": [
          "我回来了",
          "好香啊，今天做什么"
        ]
      }
    },
    "n2_kitchen": {
      "kind": "scripted",
      "priority": 60,
      "once": true,
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "presentation": {
        "narrator": "你走过去，她切菜的动作停了一下，左手却下意识地死死捂住围裙口袋。刀刃在砧板上敲出很轻的一声。",
        "npc_text": "哥哥……你今天好像心不在焉的。是有什么心事吗？还是，学校里有人欺负你了？",
        "npc_state": "警觉，左手捂着围裙口袋",
        "hint": "【岔路口】三条路只能选一条，没选的那两条会被收进挂起池，等你露出悔意的时候才有机会补回来。"
      },
      "options": [
        {
          "text": "1. 对不起，我今天有点累。",
          "next": "n3_tender"
        },
        {
          "text": "2. 没什么，你别管了。",
          "next": "n4_shut"
        },
        {
          "text": "3. 你口袋里藏了什么？",
          "next": "n5_search"
        }
      ],
      "default_next": "n6_silence",
      "fallback_next": "n_idle",
      "effects": {
        "summary_hint": "她察觉哥哥心不在焉，并捂住了围裙口袋。"
      },
      "intent": {
        "description": "厨房对话：她察觉哥哥心不在焉并主动关心，玩家含糊其辞时落在这里。",
        "keywords": [
          "没事",
          "还好",
          "没什么"
        ],
        "examples": [
          "嗯，还好吧",
          "没什么特别的"
        ],
        "negatives": [
          "口袋",
          "对不起"
        ]
      }
    },
    "n3_tender": {
      "kind": "scripted",
      "priority": 75,
      "once": true,
      "_note": "requires.step_lte=8 是 T02 新增的'叙事过期'闸门（详见 docs/ARCH_FS.md 偏差 9）：坦白示弱这条路只在今晚前 8 步之内还开着，过期即彻底消失 —— 这是 B-6『错过就是错过』能成立的前提。",
      "requires": {
        "step_lte": 8
      },
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "redeemable": true,
      "redeem_expire": 10,
      "redeem_gate": {
        "tag": "regret"
      },
      "presentation": {
        "narrator": "听到你坦白，她慢慢放下菜刀，在围裙上擦了擦手，然后从背后轻轻抱住了你。她的下巴抵在你肩上，很久都没有说话。",
        "npc_text": "没关系的，哥哥。累的时候就回来，家里永远有热饭。无论发生什么，我都会一直陪着你。",
        "npc_state": "心疼，从背后抱住你",
        "hint": "【提示】你可以抱紧她，也可以追问她口袋里的事。",
        "redeem_variant": {
          "narrator": "她没有回头，可握刀的手停了很久很久，指节一点点发白。",
          "npc_text": "……你现在才肯说啊。笨蛋哥哥，我最讨厌你逞强了。",
          "npc_state": "委屈，不肯回头"
        }
      },
      "options": [
        {
          "text": "1. 抱紧她。",
          "next": "n6_silence"
        },
        {
          "text": "2. 问她口袋里的事。",
          "next": "n5_search"
        }
      ],
      "default_next": "n7_goodnight",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": [
          "trust"
        ],
        "affinity_delta": 5,
        "summary_hint": "哥哥坦白自己很累，她抱住了他。"
      },
      "intent": {
        "description": "哥哥坦白自己很累、很脆弱，向木子因示弱求助。",
        "keywords": [
          "累",
          "撑不住",
          "对不起",
          "压力大"
        ],
        "examples": [
          "我今天真的快撑不住了",
          "对不起，我最近压力很大"
        ],
        "negatives": [
          "不用你管",
          "别管",
          "算了"
        ]
      }
    },
    "n4_shut": {
      "kind": "scripted",
      "priority": 70,
      "once": true,
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "redeemable": true,
      "redeem_expire": 10,
      "redeem_gate": {
        "tag": "trust"
      },
      "presentation": {
        "narrator": "她被你一句话顶得愣住了，眼眶一下子红了起来，却还强撑着笑了一下。厨房里的油锅开始冒烟。",
        "npc_text": "我……我只是关心你而已，你干嘛凶我……你要是不想说，那我以后就不问了。",
        "npc_state": "委屈，强撑着笑",
        "hint": "【提示】你可以沉默地看着她做饭，也可以岔开话题。",
        "redeem_variant": {
          "narrator": "她背对着你站了很久，肩膀轻轻抖了一下，才重新拿起菜刀。",
          "npc_text": "……知道了。哥哥不想说的事，我以后不问就是了。",
          "npc_state": "死心，背对着你"
        }
      },
      "options": [
        {
          "text": "1. 沉默地看着她做饭。",
          "next": "n6_silence"
        },
        {
          "text": "2. 岔开话题。",
          "next": "n7_goodnight"
        }
      ],
      "default_next": "n6_silence",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": [
          "distant"
        ],
        "affinity_delta": -10,
        "summary_hint": "哥哥拒绝沟通，她被刺痛了。"
      },
      "intent": {
        "description": "哥哥拒绝沟通，表现出防御、疏远或不耐烦。",
        "keywords": [
          "别管",
          "不用你管",
          "没有",
          "烦"
        ],
        "examples": [
          "没什么，你别管了",
          "不用你操心"
        ],
        "negatives": [
          "对不起",
          "累"
        ]
      }
    },
    "n5_search": {
      "kind": "scripted",
      "priority": 78,
      "once": true,
      "requires": {
        "any": [
          {
            "step_gte": 1
          },
          {
            "tag": "suspicious"
          }
        ]
      },
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "redeemable": true,
      "redeem_expire": 12,
      "redeem_gate": {
        "tag": "regret"
      },
      "presentation": {
        "narrator": "你一把抓住她的手腕，另一只手探进围裙口袋，掏出一枚旧发卡。卡面磨得发白，缝隙里凝着一层暗红的血迹。",
        "npc_text": "啊！还给我……哥哥，那个不能看！求你了，把它还给我好不好？",
        "npc_state": "惊慌，伸手要抢回来",
        "hint": "【提示】你可以拿着发卡质问她，也可以还给她当作没发生。",
        "redeem_variant": {
          "narrator": "她没有再抢，只是把手垂下去，一直盯着你手心里那枚发卡。",
          "npc_text": "……你终究还是看了。那你现在，打算怎么办？",
          "npc_state": "放弃争夺，眼神发冷"
        }
      },
      "options": [
        {
          "text": "1. 拿着发卡质问她。",
          "next": "end_hidden"
        },
        {
          "text": "2. 还给她，当作没发生。",
          "next": "n6_silence"
        }
      ],
      "default_next": "n6_silence",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": [
          "discovered"
        ],
        "add_items": [
          "item_hairclip"
        ],
        "affinity_delta": -15,
        "summary_hint": "哥哥从她口袋里掏出了带血的发卡。"
      },
      "intent": {
        "description": "哥哥要求检查她的口袋、拿走或追问她藏起来的东西。",
        "keywords": [
          "口袋",
          "藏",
          "发卡",
          "看看"
        ],
        "examples": [
          "你口袋里藏了什么",
          "把那个给我看看"
        ],
        "negatives": [
          "算了",
          "晚安",
          "睡"
        ]
      }
    },
    "n6_silence": {
      "kind": "scripted",
      "priority": 55,
      "once": true,
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "presentation": {
        "narrator": "厨房里只剩下刀落在砧板上的声音。窗外一寸寸暗下去，最后连对面的楼也只剩几个亮点。她始终没有回头。",
        "npc_text": "……（她把菜盛进盘子，指尖微微发抖）",
        "npc_state": "沉默，指尖发抖",
        "hint": "【提示】你可以直接对她说点什么。"
      },
      "options": [
        {
          "text": "1. 继续沉默。",
          "next": "n7_goodnight"
        }
      ],
      "default_next": "n7_goodnight",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": [
          "regret"
        ],
        "affinity_delta": -3,
        "set_phase": "night",
        "summary_hint": "长时间的沉默，哥哥开始后悔；天黑了。"
      },
      "intent": {
        "description": "长时间的沉默、回避、不说话，或双方一时无话可说。",
        "keywords": [
          "沉默",
          "不说话",
          "……"
        ],
        "examples": [
          "（沉默）",
          "我什么都不想说"
        ],
        "negatives": [
          "晚安",
          "对不起"
        ]
      }
    },
    "n7_goodnight": {
      "kind": "scripted",
      "priority": 50,
      "once": true,
      "requires": {
        "any": [
          {
            "phase_in": [
              "night",
              "late_night"
            ]
          },
          {
            "affinity_lte": 85
          }
        ]
      },
      "phase": {
        "allow": [
          "evening",
          "night",
          "late_night"
        ]
      },
      "presentation": {
        "narrator": "你道了晚安。她盯着你的背影看了很久，才把灯一盏盏关掉。走廊最后那盏灯，是她亲手替你留的。",
        "npc_text": "嗯……晚安，哥哥。明天也要早点回来。",
        "npc_state": "不舍，替你留了走廊的灯",
        "hint": "【提示】今晚就到这里了。"
      },
      "options": [
        {
          "text": "1. 回房。",
          "next": "end_calm"
        }
      ],
      "default_next": "end_calm",
      "fallback_next": "end_regret",
      "effects": {
        "affinity_delta": 2,
        "summary_hint": "夜深了，准备休息。"
      },
      "intent": {
        "description": "哥哥准备去睡觉、结束今晚的对话。",
        "keywords": [
          "晚安",
          "睡了",
          "困了",
          "回房"
        ],
        "examples": [
          "我先去睡了",
          "晚安"
        ],
        "negatives": [
          "等一下"
        ]
      }
    },
    "end_calm": {
      "kind": "ending",
      "priority": 60,
      "requires": {
        "all": [
          {
            "phase_in": [
              "night",
              "late_night"
            ]
          },
          {
            "affinity_gte": 82
          }
        ]
      },
      "presentation": {
        "narrator": "这一页就这样翻过去了。她有没有睡着，你并不知道；她围裙口袋里那点冰凉的秘密，你也始终没有问出口。",
        "npc_text": "嗯……明天见，哥哥。记得吃早饭。",
        "npc_state": "平静",
        "hint": "【结局·和解】"
      },
      "options": [
        {
          "text": "1. 结束演出。",
          "next": "-1"
        }
      ],
      "default_next": "-1",
      "intent": {
        "description": "今夜到此为止：在彼此都没有受伤的氛围里结束今晚。",
        "keywords": [
          "结束",
          "回头见",
          "明天见"
        ],
        "examples": [
          "那我回房了",
          "明天见"
        ]
      }
    },
    "end_hidden": {
      "kind": "ending",
      "priority": 100,
      "requires": {
        "item": "item_hairclip"
      },
      "presentation": {
        "narrator": "你举起那枚带血的发卡。她的表情一点点空了下去，那种乖巧的笑容像纸一样，被从中间慢慢撕开。",
        "npc_text": "（眼神变得空洞）既然哥哥发现了……那我也没必要再装成乖乖女了吧？反正，你哪儿也去不了。",
        "npc_state": "伪装撕裂，眼神空洞",
        "hint": "【结局·真相】"
      },
      "options": [
        {
          "text": "1. 结束演出。",
          "next": "-1"
        }
      ],
      "default_next": "-1",
      "intent": {
        "description": "今夜到此为止：哥哥握着那枚带血的发卡逼问到底，伪装被彻底撕开。",
        "keywords": [
          "发卡",
          "血",
          "是谁的",
          "说实话"
        ],
        "examples": [
          "这上面的血到底是谁的",
          "你到底在瞒我什么"
        ],
        "negatives": [
          "算了",
          "还给你"
        ]
      }
    },
    "end_regret": {
      "kind": "ending",
      "priority": 90,
      "requires": {
        "all": [
          {
            "any": [
              {
                "tag": "regret"
