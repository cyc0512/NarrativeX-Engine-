      "presentation": {
        "narrator": "天亮之前，厨房里再没有响起过任何声音。你想说的那句话，终究还是晚了一步——有些门，关上就不会再开。",
        "npc_text": "……（她把最后一个盘子收进柜子，没有回头）",
        "npc_state": "已经不想再听了",
        "hint": "【结局·遗憾】"
      },
      "options": [
        {
          "text": "1. 结束演出。",
          "next": "-1"
        }
      ],
      "default_next": "-1",
      "intent": {
        "description": "今夜到此为止：话说得太晚，她已经不想再听了。",
        "keywords": [
          "算了",
          "当我没说",
          "没什么"
        ],
        "examples": [
          "算了，当我没说",
          "没什么要紧的"
        ],
        "negatives": [
          "对不起",
          "累"
        ]
      }
    },
    "n_idle": {
      "kind": "fallback",
      "priority": 10,
      "once": false,
      "cooldown": 1,
      "presentation": {
        "narrator": "你没有说话。水开了，壶嘴发出细小的尖啸，谁都没有去关。",
