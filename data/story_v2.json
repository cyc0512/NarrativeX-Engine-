  "nodes": {
    "n1_entry": {
      "kind": "scripted",
      "priority": 100,
      "once": true,
      "window": { "min_step": 0, "max_step": 2 },
      "phase": { "allow": ["evening", "night", "late_night"] },
      "presentation": {
        "narrator": "那是四年前的一个大雨天，雨水冷得刺骨，我正烦躁地往家赶。\n\n抄近路穿过小巷时，我一不留神，在水坑边撞倒了一个瘦小的身影。\n\n她身上披着个破旧的塑料袋，跌坐在泥水里。我原本想发火，可抬眼那刻，却撞进了一双充斥着泥泞与绝望的眼睛里。\n\n我见过太多流浪猫狗的眼神，可那一刻，我仿佛看到了曾经那个同样孤立无援的自己。于是，我向她伸出了手。\n\n一晃四年过去了，我大学毕业开始艰难创业，当年那个瘦小的女孩——木子因，也长成了高中生。她最初拘谨得像个随时会被丢弃的机器，小心翼翼。但在我反复保证绝不会抛弃她之后，她在这个家里终于有了安全感，只是……她对我的情绪，似乎变得有些异常。\n\n今天傍晚，我带着被女上司硬塞过来的几份客户资料回到家，疲惫得连衣服都没换，就一头栽进了沙发里。\n\n不知睡了多久，我睁开眼，却发现木子因正拿着那份客户的资料，目光失神地死死盯着上面。",
        "npc_text": "哥哥，她的眼睛真好看呢。",
        "npc_state": "目光失神，拿着客户资料，试探",
        "hint": "【岔路口】她拿着客户的资料，语气微妙。你需要回应她。"
      },
      "options": [
        { "text": "解释：这是我们公司安排要见的客户。", "next": "n2_kitchen" },
        { "text": "回避：我很累，晚一点和你解释。", "next": "n3_shut" }
      ],
      "default_next": "n3_shut",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": ["suspicious"],
        "summary_hint": "哥哥醒来，看到木子因在看客户的资料。"
      },
            "intent": {
        "description": "承接开场试探：木子因询问客户资料。玩家进行解释、敷衍、暴躁推开、或表达偏爱与病态占有。",
        "keywords": ["客户", "工作", "累", "关你什么事", "只在乎你", "只爱你", "别多想"],
        "examples": [
          "这是公司的客户，别瞎想",
          "我很累，晚点说",
          "关你什么事，少管我",
          "我只在乎你一个人",
          "我只爱你，别的都不重要",
          "你别多想，只是工作"
        ],
        "negatives": []
      }
    },
    "n2_kitchen": {
      "kind": "scripted",
      "priority": 60,
      "once": true,
      "phase": { "allow": ["evening", "night", "late_night"] },
      "presentation": {
        "narrator": "她没有继续追问，而是去厨房端出了丰盛的晚餐。每一道菜都是我喜欢吃的重口味。可我知道，长期的营养不良让她根本吃不了这些，但她装作没事一般，笑着不断给我夹菜。",
        "npc_text": "哥哥多吃点，今天上班肯定累坏了。",
        "npc_state": "强颜欢笑，不断给你夹菜",
        "hint": "【岔路口】她为了迎合你做了重油辛辣的菜，自己却吃不了。"
      },
      "options": [
        { "text": "明天我要去见那个客户，不用替我做饭了。", "next": "n3_shut" },
        { "text": "沉默，心想怎么推掉明天的客户。", "next": "n4_silence" }
      ],
      "default_next": "n4_silence",
      "fallback_next": "n_idle",
      "effects": {
        "summary_hint": "晚饭时，她强撑着不适给你夹菜。"
      },
      "intent": {
        "description": "晚餐交谈：玩家针对她做饭和客户事宜做出选择。推开、沉默、暴躁、关心身体、或表达病态爱意。",
        "keywords": ["客户", "推掉", "暴躁", "胃痛", "吃清淡", "喂我"],
        "examples": [
          "我明天还要见客户，别做了",
          "你胃不好，吃点清淡的",
          "别光顾着我，你自己吃",
          "真希望一直这样被你喂下去"
        ],
        "negatives": []
      }
    },
    "n3_shut": {
      "kind": "scripted",
      "priority": 70,
      "once": true,
      "phase": { "allow": ["evening", "night", "late_night"] },
      "redeemable": true,
      "redeem_expire": 10,
      "redeem_gate": { "tag": "regret" },
      "presentation": {
        "narrator": "她听完我的话，默默地放下了筷子，低声说了句：“我吃饱了。”随后站起身，转身走进了房间，重重地关上了门。",
        "npc_text": "（门内没有任何声音，只有死一般的寂静）",
        "npc_state": "委屈，落差极大，锁在房间里",
        "hint": "【提示】她把自己关进了房间。你想做点什么吗？",
        "redeem_variant": {
          "narrator": "她愣愣地看着我，似乎要从我眼睛里读出什么。过了许久，她一言不发，把吃完的碗筷端进了厨房，背影显得格外单薄。",
          "npc_text": "……（水龙头的水声一直响着）",
          "npc_state": "委屈，失去安全感"
        }
      },
      "options": [
        { "text": "去敲她的房门道歉。", "next": "n4_silence" },
        { "text": "觉得很累，不想管，回房睡觉。", "next": "n6_goodnight" }
      ],
      "default_next": "n6_goodnight",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": ["distant", "委屈", "落差"],
        "affinity_delta": -10,
        "summary_hint": "哥哥的话语刺痛了她，她关上了房门。"
      },
      "intent": {
        "description": "哥哥表现出暴躁、责备、推开，或者提及工作拒绝她的好意。",
        "keywords": ["关你什么事", "别问", "烦", "不用你管", "客户"],
        "examples": ["关你什么事", "别做了，我明天要见客户", "烦死了"],
        "negatives": ["对不起", "累", "吃清淡"]
      }
    },
    "n4_silence": {
      "kind": "scripted",
      "priority": 55,
      "once": true,
      "phase": { "allow": ["evening", "night", "late_night"] },
      "presentation": {
        "narrator": "餐桌上只剩下沉默。我没有说话，她也没有动。房间里安静得能听到窗外树叶摩擦的声音。",
        "npc_text": "……（她坐在原地，手指不安地绞在一起）",
        "npc_state": "沉默，不知所措",
        "hint": "【提示】你可以直接对她说点什么，打破沉默。"
      },
      "options": [
        { "text": "继续沉默。", "next": "n6_goodnight" }
      ],
      "default_next": "n6_goodnight",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": ["regret"],
        "affinity_delta": -3,
        "set_phase": "night",
        "summary_hint": "长时间的沉默，哥哥开始后悔；天黑了。"
      },
      "intent": {
        "description": "长时间的沉默、回避、不说话，或双方一时无话可说。",
        "keywords": ["沉默", "不说话", "……"],
        "examples": ["（沉默）", "我什么都不想说"],
        "negatives": ["晚安", "对不起"]
      }
    },
    "n5_tender": {
      "kind": "scripted",
      "priority": 75,
      "once": true,
      "requires": { "step_lte": 8 },
      "phase": { "allow": ["evening", "night", "late_night"] },
      "presentation": {
        "narrator": "听到我的关心或病态的偏爱，她给我夹了更多的菜。我们享用了一顿看似丰盛温馨的晚餐。她看着我，眼神里满是沉甸甸的依恋。",
        "npc_text": "哥哥最好了……只要哥哥不离开我，我做什么都可以。",
        "npc_state": "信任，极度依恋，放松",
        "hint": "【提示】她此刻显得极度信任你。",
        "redeem_variant": {
          "narrator": "她停下了动作，眼眶微红，似乎没想到我会这么说。",
          "npc_text": "……真的吗？哥哥真的只在乎我吗？",
          "npc_state": "感动，却又患得患失"
        }
      },
      "options": [
        { "text": "摸摸她的头，安抚她。", "next": "n6_goodnight" }
      ],
      "default_next": "n6_goodnight",
      "fallback_next": "n_idle",
      "effects": {
        "add_tags": ["trust", "病态的爱"],
        "affinity_delta": 8,
        "summary_hint": "哥哥给出了关心与偏爱，她感到信任与满足。"
      },
      "intent": {
        "description": "哥哥给出安抚、关心，或表达出病态的爱意与占有欲，让她感到被在乎。",
        "keywords": ["只在乎你", "只爱你", "别怕", "保护", "喂我"],
        "examples": ["我只在乎你", "别乱想，我只爱你一个人", "你胃不好，吃点清淡的"],
        "negatives": ["不用你管", "别管", "算了"]
      }
    },
    "n6_goodnight": {
      "kind": "scripted",
      "priority": 50,
      "once": true,
      "requires": {
        "any": [
          { "phase_in": ["night", "late_night"] },
          { "affinity_lte": 85 }
        ]
      },
      "phase": { "allow": ["evening", "night", "late_night"] },
      "presentation": {
        "narrator": "夜深了。我站起身准备回房休息。她默默收拾着碗筷，在我转身的瞬间，轻声开口。",
        "npc_text": "……晚安，哥哥。明天，也要早点回来。",
        "npc_state": "不舍，盯着你的背影",
        "hint": "【提示】今晚就到这里了。"
      },
      "options": [
        { "text": "回房。", "next": "end_peace" }
      ],
      "default_next": "end_peace",
      "fallback_next": "end_emptiness",
      "effects": {
        "affinity_delta": 2,
        "summary_hint": "夜深了，准备休息。"
      },
      "intent": {
        "description": "哥哥准备去睡觉、结束今晚的对话。",
        "keywords": ["晚安", "睡了", "困了", "回房"],
        "examples": ["我先去睡了", "晚安"],
        "negatives": ["等一下"]
      }
    },
    "end_peace": {
      "kind": "ending",
      "priority": 60,
      "requires": {
        "all": [
          { "phase_in": ["night", "late_night"] },
          { "affinity_gte": 82 }
        ]
      },
      "presentation": {
        "narrator": "这一夜，她似乎睡得很安稳。我推开房门时，还能听到她房间里传来的均匀呼吸声。我们都在这个家里，找到了短暂的平静。",
        "npc_text": "（房间里传来细微的呢喃）哥哥……不要走……",
        "npc_state": "安睡",
        "hint": "【结局·平静】"
      },
      "options": [
        { "text": "结束演出。", "next": "-1" }
      ],
      "default_next": "-1",
      "intent": {
        "description": "今夜到此为止：彼此都没有受伤，安然入睡。",
        "keywords": ["结束", "睡吧", "晚安"],
        "examples": ["晚安", "睡个好觉"],
        "negatives": []
      }
    },
    "end_emptiness": {
      "kind": "ending",
      "priority": 90,
      "requires": {
        "all": [
          { "any": [{ "tag": "regret" }, { "step_gte": 9 }] },
          { "affinity_lte": 81 }
        ]
      },
      "presentation": {
        "narrator": "她站在水池边，看着水流冲刷着盘子。我回了房间，没有再回头。厨房的灯一直亮到天亮。那些没有被安抚的落差和委屈，像疯长的藤蔓一样，在沉默中缠绕。",
        "npc_text": "……（她把水龙头关掉，靠在冰凉的瓷砖上，慢慢滑落蹲下）",
        "npc_state": "绝望，落差，委屈",
        "hint": "【结局·虚空】"
      },
      "options": [
        { "text": "结束演出。", "next": "-1" }
      ],
      "default_next": "-1",
      "intent": {
        "description": "今夜到此为止：带着没有解开的心结和落差结束。",
        "keywords": ["算了", "当我没说", "没什么"],
        "examples": ["算了，当我没说", "没什么要紧的"],
        "negatives": ["对不起", "累"]
      }
    },
    "n_idle": {
      "kind": "fallback",
      "priority": 10,
      "once": false,
      "cooldown": 1,
      "presentation": {
        "narrator": "我没有说话。钟表秒针走动的声音在客厅里被无限放大。",
        "npc_text": "……哥哥？你今天，到底怎么了？",
        "npc_state": "等待",
        "hint": "【提示】你可以直接对她说点什么。"
      },
      "options": [
        { "text": "回去继续刚才的话题。", "next": "n6_goodnight" }
      ],
      "default_next": "n6_goodnight",
      "effects": {
        "summary_hint": "两个人都没有开口。"
      },
      "intent": {
        "description": "无明确意图时的保底闲聊，防止玩家无路可走导致死锁。",
        "keywords": [],
        "examples": ["……"],
        "negatives": [],
        "must_freeform": true
      }
    },
    "-1": {
      "kind": "ending",
      "terminal": true,
      "priority": 0,
      "once": false,
      "presentation": {
        "narrator": "【游戏结束】感谢游玩 FluidStory。",
        "npc_text": ""
      },
      "options": [],
      "default_next": "",
      "intent": {
        "description": "终末占位节点（Terminal）。",
        "keywords": [],
        "examples": [],
        "negatives": []
      }
    }
  }
