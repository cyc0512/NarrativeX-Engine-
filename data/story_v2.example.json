{
  "_comment": "NarrativeX 动态节点模型 v2 样例剧本。与旧 story.json 的区别：节点不再靠写死的 next 一条线走到底，而是由 requires(准入) + window(生命周期) + phase(物理时间) + priority(优先级) + redeemable(可挽回) 五个维度共同决定它何时出现在 Frontier。",
  "phases": [
    "evening",
    "night",
    "late_night"
  ],
  "frontier": {
    "w_base": 1.0,
    "w_urgency": 0.8,
    "w_staleness": 1.2,
    "w_affinity": 0.4,
    "w_recency": 0.35,
    "w_pending_age": 0.5,
    "staleness_tau": 6.0,
    "urgency_horizon": 12,
    "top_k": 5,
    "temperature": 0.0
  },
  "intent": {
    "kw_hit_score": 0.55,
    "kw_full_bonus": 0.3,
    "sim_weight": 0.45,
    "neg_penalty": 0.5,
    "l0_confident": 0.86,
    "l1_margin": 0.12,
    "mmr_lambda": 0.25,
    "top_k": 5
  },
  "budget": {
    "total_tokens": 1400,
    "persona": 260,
    "world": 140,
    "summary": 180,
    "history": 360,
    "routes": 320,
    "output": 140,
    "max_history_turns": 6
  },
  "nodes": {
    "0": {
      "kind": "scripted",
      "priority": 100,
      "window": {
        "min_step": 0,
        "max_step": 2
      },
      "phase": {
        "allow": [
          "evening"
        ]
      },
      "presentation": {
        "narrator": "【旁白】周末的傍晚，你推开家门。厨房里传来阵阵香味。",
        "npc_text": "木子因：“哥哥，你回来啦。今天大学那边累不累？晚饭马上就好。”",
        "hint": "【提示】走过去。"
      },
      "options": [
        {
          "text": "1. 走进厨房。",
          "next": "n_kitchen"
        }
      ],
      "default_next": "n_kitchen",
      "fallback_next": "n_idle",
      "intent": {
        "description": "开场：哥哥刚回到家，木子因在厨房做饭。用于承接玩家的任何开场寒暄。",
        "keywords": [
          "回来了"
        ],
        "examples": [
          "我回来了",
          "好香啊"
        ]
      }
    },
    "n_kitchen": {
      "kind": "scripted",
      "priority": 60,
      "once": true,
      "phase": {
        "allow": [
          "evening"
        ]
      },
      "presentation": {
        "narrator": "【旁白】你走过去，她切菜的动作停了下来。她的左手死死捂住围裙口袋。",
        "npc_text": "木子因：“哥哥……你今天好像心不在焉的。是有什么心事吗？”",
        "hint": "【关键节点】岔路口：三条路只能选一条，其余两条会被压入挂起池等待挽回。"
      },
      "options": [
        {
          "text": "1. 对不起，我有点累。",
          "next": "n_tired"
        },
        {
          "text": "2. 没什么，你别管了。",
          "next": "n_refuse"
        },
        {
          "text": "3. 你口袋里是什么？",
          "next": "n_search"
        }
      ],
      "default_next": "n_idle",
      "fallback_next": "n_idle",
      "intent": {
        "description": "厨房对话：木子因察觉哥哥心不在焉并主动关心，玩家可选择示弱、回避或追问。",
        "keywords": [
          "心不在焉",
          "有事吗"
        ],
        "examples": [
          "我没事",
          "今天有点不对劲"
        ]
      }
    },
    "n_tired": {
      "kind": "scripted",
      "priority": 75,
      "redeemable": true,
      "redeem_expire": 10,
      "redeem_gate": {
        "tag": "regret"
      },
      "effects": {
        "add_tags": [
          "trust"
        ],
        "affinity_delta": 5,
        "summary_hint": "哥哥坦白了自己很累。"
      },
      "presentation": {
        "narrator": "【旁白】听到你的坦白，她放下了菜刀，轻轻抱住了你。",
        "npc_text": "木子因：“没关系的，哥哥。无论发生什么，我都会一直陪着你。”"
      },
      "options": [
        {
          "text": "1. 抱紧她。",
          "next": "n_bridge"
        },
        {
          "text": "2. 问她口袋里的事。",
          "next": "n_search"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "哥哥坦白自己很累、很脆弱，向木子因示弱求助。",
        "keywords": [
          "累",
          "抱歉",
          "对不起"
        ],
        "examples": [
          "我今天真的很累",
          "对不起，我最近压力很大"
        ],
        "negatives": [
          "不用你管"
        ]
      }
    },
    "n_refuse": {
      "kind": "scripted",
      "priority": 70,
      "redeemable": true,
      "redeem_expire": 10,
      "redeem_gate": {
        "tag": "trust"
      },
      "effects": {
        "add_tags": [
          "distant"
        ],
        "affinity_delta": -10,
        "summary_hint": "哥哥拒绝沟通。"
      },
      "presentation": {
        "narrator": "【旁白】她被你反问得愣住了，眼眶瞬间红了起来。",
        "npc_text": "木子因：“我……我只是关心你而已，你干嘛凶我……”"
      },
      "options": [
        {
          "text": "1. 沉默地看着她做饭。",
          "next": "n_silence"
        },
        {
          "text": "2. 岔开话题。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_silence",
      "intent": {
        "description": "哥哥拒绝沟通，表现出防御、疏远或不耐烦。",
        "keywords": [
          "别管",
          "不用你管",
          "没有"
        ],
        "examples": [
          "没什么，你别管了",
          "不用你操心"
        ],
        "negatives": [
          "对不起"
        ]
      }
    },
    "n_search": {
      "kind": "scripted",
      "priority": 78,
      "redeemable": true,
      "redeem_expire": 12,
      "requires": {
        "step_gte": 2
      },
      "effects": {
        "add_items": [
          "item_hairclip"
        ],
        "add_tags": [
          "discovered"
        ],
        "affinity_delta": -15,
        "summary_hint": "哥哥从她口袋里掏出了带血的发卡。"
      },
      "presentation": {
        "narrator": "【旁白】你一把抓住她的手腕，从她口袋里掏出一枚沾着暗红血迹的旧发卡。",
        "npc_text": "木子因：“啊！还给我……哥哥，那个不能看！求你了！”"
      },
      "options": [
        {
          "text": "1. 拿着发卡质问她。",
          "next": "n_confront"
        },
        {
          "text": "2. 还给她，当作没发生。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "哥哥要求检查她的口袋、拿走或追问她藏起来的东西。",
        "keywords": [
          "口袋",
          "发卡",
          "什么东西"
        ],
        "examples": [
          "你口袋里藏了什么",
          "把那个给我看看"
        ],
        "negatives": [
          "算了"
        ]
      }
    },
    "n_silence": {
      "kind": "scripted",
      "priority": 55,
      "effects": {
        "add_tags": [
          "regret"
        ],
        "affinity_delta": -3,
        "summary_hint": "长时间的沉默，哥哥开始后悔。"
      },
      "presentation": {
        "narrator": "【旁白】厨房里只剩下刀落在砧板上的声音。她始终没有回头。",
        "npc_text": "木子因：“……”（她把菜盛进盘子，指尖微微发抖）"
      },
      "options": [
        {
          "text": "1. 对不起，我不该那样说。",
          "next": "n_apologize"
        },
        {
          "text": "2. 继续沉默。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "长时间的沉默、回避、不说话。",
        "keywords": [
          "沉默",
          "不说话"
        ],
        "examples": [
          "（沉默）",
          "我什么都不想说"
        ]
      }
    },
    "n_apologize": {
      "kind": "scripted",
      "priority": 82,
      "requires": {
        "all": [
          {
            "tag": "regret"
          },
          {
            "affinity_lte": 95
          }
        ]
      },
      "effects": {
        "remove_tags": [
          "distant"
        ],
        "affinity_delta": 12,
        "summary_hint": "哥哥道歉了，关系缓和。"
      },
      "presentation": {
        "narrator": "【旁白】她的肩膀终于松了下来，转过身，眼圈还是红的。",
        "npc_text": "木子因：“……笨蛋哥哥。你只要好好说，我什么都会原谅你的。”"
      },
      "options": [
        {
          "text": "1. 相视而笑。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "哥哥真诚道歉、认错、请求原谅。",
        "keywords": [
          "对不起",
          "道歉",
          "原谅"
        ],
        "examples": [
          "刚才是我不好",
          "抱歉，原谅我"
        ],
        "negatives": [
          "但是我"
        ]
      }
    },
    "n_confront": {
      "kind": "emergent",
      "priority": 95,
      "requires": {
        "item": "item_hairclip"
      },
      "effects": {
        "add_tags": [
          "truth"
        ],
        "affinity_delta": -20,
        "set_phase": "late_night",
        "summary_hint": "伪装撕裂，木子因露出病娇本性。"
      },
      "presentation": {
        "narrator": "【旁白】你举起那枚带血的发卡。她的伪装瞬间消失了。",
        "npc_text": "木子因：“（眼神变得空洞）既然哥哥发现了……那我也没必要装成乖乖女了吧？”"
      },
      "options": [
        {
          "text": "1. 后退一步。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "哥哥拿着发卡质问木子因，追问发卡的来历。",
        "keywords": [
          "发卡",
          "血",
          "是谁"
        ],
        "examples": [
          "这个发卡是谁的",
          "上面为什么有血"
        ]
      }
    },
    "n_bridge": {
      "kind": "scripted",
      "priority": 40,
      "once": false,
      "cooldown": 2,
      "window": {
        "min_step": 0,
        "max_step": 30
      },
      "presentation": {
        "narrator": "【旁白】窗外的天色一寸寸暗下去。",
        "npc_text": "木子因：“哥哥，你还要站很久吗？”"
      },
      "options": [
        {
          "text": "1. 说晚安。",
          "next": "n_goodnight"
        },
        {
          "text": "2. 再待一会儿。",
          "next": "n_idle"
        }
      ],
      "default_next": "n_idle",
      "intent": {
        "description": "过渡场景，哥哥在等待、发呆或准备结束今晚。",
        "keywords": [
          "晚安",
          "再待一会"
        ],
        "examples": [
          "再待一会儿吧",
          "有点晚了"
        ]
      }
    },
    "n_goodnight": {
      "kind": "scripted",
      "priority": 50,
      "effects": {
        "set_phase": "night",
        "affinity_delta": 2,
        "summary_hint": "夜深了，准备休息。"
      },
      "presentation": {
        "narrator": "【旁白】你道了晚安。她盯着你的背影看了很久。",
        "npc_text": "木子因：“嗯……晚安，哥哥。”"
      },
      "options": [
        {
          "text": "1. 回房。",
          "next": "end_calm"
        }
      ],
      "default_next": "end_calm",
      "intent": {
        "description": "哥哥准备去睡觉、结束今晚。",
        "keywords": [
          "晚安",
          "睡觉"
        ],
        "examples": [
          "该睡了",
          "我去睡了"
        ]
      }
    },
    "end_calm": {
      "kind": "ending",
      "priority": 100,
      "requires": {
        "phase_index_gte": 1
      },
      "presentation": {
        "narrator": "【结局】这一页就这样翻过去了。她有没有睡着，你并不知道。",
        "npc_text": "—— FluidStory DEMO END ——"
      },
      "options": [
        {
          "text": "1. 结束演出",
          "next": "-1"
        }
      ],
      "default_next": "-1",
      "intent": {
        "description": "结束本次演出。"
      }
    },
    "n_idle": {
      "kind": "fallback",
      "priority": 10,
      "once": false,
      "cooldown": 1,
      "presentation": {
        "narrator": "【旁白】你没有说话。厨房里的水开了，发出细小的尖啸。",
        "npc_text": "木子因：“……哥哥？”"
      },
      "options": [
        {
          "text": "1. 回去继续刚才的话题。",
          "next": "n_bridge"
        }
      ],
      "default_next": "n_bridge",
      "intent": {
        "description": "无明确意图时的保底闲聊，防止玩家无路可走导致死锁。",
        "keywords": [],
        "examples": [
          "……"
        ],
        "must_freeform": true
      }
    },
    "-1": {
      "_note": "terminal=true 是关键：否则这个无 requires 的 ending 节点会常驻 Frontier 最高 bucket，开局就被路由到游戏结束。",
      "kind": "ending",
      "terminal": true,
      "priority": 0,
      "once": false,
      "presentation": {
        "narrator": "【游戏结束】感谢游玩。",
        "npc_text": ""
      },
      "options": [],
      "default_next": null,
      "intent": {
        "description": "终末占位节点（Terminal）。"
      }
    }
  }
}