        "0": {
            "narrator": "【旁白】：九月初，高三的教室里弥漫着粉笔灰和紧张的气息。你走到自己的座位旁，发现同桌已经坐在那里了。",
            "npc_text": "木子因：早啊。你就是我的新同桌吧？我叫木子因。",
            "hint": "【提示】输入数字选择，或者自由输入你想说的话。",
            "options": [
                "1. 你好，我叫...（做个自我介绍）",
                "2. 点头微笑，默默坐下。",
                "3. 【自由输入】我想自己说点什么..."
            ],
            "rules": [
                {
                    "regex": "(你好|我叫|名字)",
                    "reply": "木子因：哈哈，你看起来有点紧张呢，高三一起加油吧！",
                    "affinity": 10,
                    "next_node": "1"
                },
                {
                    "regex": "(点头|微笑|沉默)",
                    "reply": "木子因：怎么这么高冷呀？(她撇了撇嘴，转过头去翻书了)",
                    "affinity": -5,
                    "next_node": "2"
                }
            ],
            "default_reply": "木子因：嗯？你在嘟囔什么呢？",
            "default_next": "0"
        },
        "1": {
            "narrator": "【旁白】：听到你的回答，她眼睛亮了一下。",
            "npc_text": "木子因：那以后我们就是同桌啦，多多关照！对了，你喜欢学什么科目呀？",
            "hint": "【提示】聊聊你喜欢的科目。",
            "options": [
                "1. 我喜欢数学。",
                "2. 我喜欢语文。",
                "3. 【自由输入】我想自己说点什么..."
            ],
            "rules": [
                {
                    "regex": "(数学|理科)",
                    "reply": "木子因：哇，数学大佬！那以后我的作业就靠你了！",
                    "affinity": 15,
                    "next_node": "-1"
                },
                {
                    "regex": "(语文|文科)",
                    "reply": "木子因：真的吗？我也喜欢！下次我们交换看书吧。",
                    "affinity": 15,
                    "next_node": "-1"
                }
            ],
            "default_reply": "木子因：不管什么科目，高三都要拼命啦。",
            "default_next": "1"
        },
        "2": {
            "narrator": "【旁白】：气氛稍微有点尴尬，空气安静了几秒钟。",
            "npc_text": "木子因：那个...桌角压到我的书了，麻烦挪一下。",
            "hint": "【提示】输入你想怎么做。",
            "options": [
                "1. 赶紧把书挪开。",
                "2. 假装没听见。",
                "3. 【自由输入】我想自己说点什么..."
            ],
            "rules": [
                {
                    "regex": "(挪|对不起|抱歉)",
                    "reply": "木子因：没...没事，谢谢。(她的语气稍微缓和了一点)",
                    "affinity": 5,
                    "next_node": "-1"
                },
                {
                    "regex": "(不|没听见|不管)",
                    "reply": "木子因：喂！你这人怎么这样啊！",
                    "affinity": -10,
                    "next_node": "-1"
                }
            ],
            "default_reply": "木子因：算了，我自己拿吧。",
            "default_next": "-1"
